{
  // Workspace settings, shared with the published repository by scripts/publish.sh.
  //
  // These live here rather than in .devcontainer/devcontainer.json so that changing them only needs a `git pull`, not a container rebuild --- the same arrangement as the sibling 260808 repo.
  // The cost is that they also apply to a local VS Code window opened on this folder, not only to a Codespace.

  // Turn off the AI chat surfaces.
  // The panel crowds an already busy window, and in a course whose projects are the exercise it offers to answer the question the student is meant to work out.
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "github.copilot.enable": { "*": false },
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // Open the README *rendered*, not as raw markdown, when the window opens with nothing else restored.
  // This is the whole navigation surface --- its links are how a student reaches a notebook --- so the preview is the point, and clickable links are what it buys.
  // devcontainer.json deliberately carries no `openFiles` key: that opens a plain text editor and, firing first, pre-empts this.
  "workbench.startupEditor": "readme",

  // The virtual environment lives inside the workspace, so without this VS Code watches and indexes several thousand library files it has no reason to care about --- noticeable on a 2-core Codespace.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.jupyter_cache/**": true,
    "**/_freeze/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.jupyter_cache": true,
    "**/_freeze": true
  },

  // Preselects the project environment, so opening a notebook does not start with a kernel prompt.
  // Also set in devcontainer.json for the Codespace; here it covers a local window too.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // The same environment, for Quarto.
  //
  // The setting above tells the Python extension which interpreter to use. It does
  // not reach the `quarto` CLI, which reads QUARTO_PYTHON and otherwise takes
  // whichever python3 is first on PATH --- homebrew's, on the machine this was
  // written on. Quarto's jupyter shim imports yaml before doing anything else, and
  // that python has no yaml, so a `quarto render` typed into a terminal here died
  // with "No module named 'yaml'" and "Jupyter is not available in this Python
  // installation": an error about the environment in place of whatever you were
  // actually rendering.
  //
  // scripts/deploy.sh sets this variable itself, so the site build was never
  // affected --- only rendering a single document by hand, which is the normal way
  // to work on one. Both platforms are named because the Codespace is Linux.
  "terminal.integrated.env.osx": {
    "QUARTO_PYTHON": "${workspaceFolder}/.venv/bin/python3"
  },
  "terminal.integrated.env.linux": {
    "QUARTO_PYTHON": "${workspaceFolder}/.venv/bin/python3"
  }
}
